        "set_robust_list",
        "get_robust_list",
        "rseq",
        "gettid",
        "getpid",
        "getppid",
        "sched_yield",
        "sched_getaffinity",
        "sched_setaffinity",
        "sched_getparam",
        "sched_getscheduler",
        "prctl",
        "arch_prctl"
      ]
    },
    {
      "_group": "signals",
      "action": "SCMP_ACT_ALLOW",
      "names": [
